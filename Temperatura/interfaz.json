{
  "app": {
    "nombre": "Termostato",
    "idioma": "es",
    "tipografia": "Familjen Grotesk",
    "tema": {
      "modo": "automatico (claro/oscuro segun el sistema)",
      "claro": { "fondo": "#eef2f1", "panel": "#ffffff", "texto": "#14262b", "apagado": "#5d7176", "linea": "#d3dcdb", "frio": "#0f6b6b", "calor": "#c4501b" },
      "oscuro": { "fondo": "#101a1c", "panel": "#182427", "texto": "#e6efee", "apagado": "#8fa5a9", "linea": "#2b3c40", "frio": "#4fc3c3", "calor": "#ff8a55" }
    }
  },

  "origen_datos": {
    "lectura": {
      "metodo": "GET",
      "url": "https://CCR-alt.github.io/data/temperaturas.json",
      "refresco_segundos": 300
    },
    "escritura": {
      "metodo": "PUT",
      "url": "https://api.github.com/repos/CCR-alt/CCR-alt.github.io/contents/docs/control.json",
      "autenticacion": "Bearer <token fine-grained con Contents: write>",
      "cuerpo": { "message": "Control desde la web", "sha": "<sha actual del fichero>", "content": "<control.json en base64>" },
      "efecto": "La Raspberry Pi descarga el fichero en menos de 1 minuto y aplica el cambio"
    }
  },

  "pantalla_principal": {
    "disposicion": "una sola columna, ancho maximo 860 px, secciones apiladas",
    "secciones": [
      {
        "id": "actual",
        "titulo": null,
        "descripcion": "Lectura actual en grande y estado del rele",
        "componentes": [
          { "tipo": "numero_grande", "dato": "actual.temperatura", "formato": "1 decimal", "unidad": "°C" },
          {
            "tipo": "etiqueta_estado",
            "dato": "actual.rele",
            "textos": { "true": "Calefaccion encendida", "false": "Calefaccion apagada" },
            "color_si_true": "calor"
          },
          {
            "tipo": "texto_secundario",
            "plantilla": "Modo {control.modo} · consigna {control.consigna} °C · ultima lectura {actual.fecha_hora}"
          }
        ],
        "estado_sin_datos": "Sin datos"
      },
      {
        "id": "grafica",
        "titulo": "Ultimas 24 horas",
        "componentes": [
          {
            "tipo": "grafica_linea",
            "dato": "recientes",
            "eje_x": "hora (primera y ultima lectura)",
            "eje_y": "temperatura °C (min y max redondeados con margen de 1 °C)",
            "series": [
              { "nombre": "Temperatura", "color": "frio", "trazo": "continuo" },
              { "nombre": "Consigna", "dato": "control.consigna", "color": "calor", "trazo": "discontinuo" }
            ]
          }
        ],
        "estado_sin_datos": "Aun no hay suficientes lecturas."
      },
      {
        "id": "estadisticas_dia",
        "titulo": "Estadisticas del dia",
        "componentes": [
          { "tipo": "selector", "etiqueta": "Dia", "opciones": "claves de diario (mas reciente primero)" },
          {
            "tipo": "tabla",
            "dato": "diario[dia seleccionado]",
            "columnas": ["Dia", "Total", "Madrugada (0–6 h)", "Manana (6–12 h)", "Tarde (12–18 h)", "Noche (18–24 h)"],
            "celda": "{media}° y debajo {min}–{max}",
            "celda_vacia": "–",
            "scroll_horizontal": true
          }
        ]
      },
      {
        "id": "estadisticas_mes",
        "titulo": "Estadisticas mensuales",
        "componentes": [
          {
            "tipo": "tabla",
            "dato": "mensual",
            "orden": "mes mas reciente primero",
            "columnas": ["Mes", "Total", "Madrugada (0–6 h)", "Manana (6–12 h)", "Tarde (12–18 h)", "Noche (18–24 h)"],
            "celda": "{media}° y debajo {min}–{max}",
            "scroll_horizontal": true
          }
        ]
      },
      {
        "id": "control",
        "titulo": "Controlar el termostato",
        "tipo": "panel_desplegable (cerrado por defecto)",
        "componentes": [
          {
            "tipo": "selector",
            "etiqueta": "Modo",
            "campo": "modo",
            "opciones": [
              { "valor": "auto", "texto": "Automatico" },
              { "valor": "on", "texto": "Siempre encendido" },
              { "valor": "off", "texto": "Apagado" }
            ]
          },
          { "tipo": "numero", "etiqueta": "Consigna (°C)", "campo": "consigna", "min": 5, "max": 35, "paso": 0.5 },
          { "tipo": "numero", "etiqueta": "Histeresis (°C)", "campo": "histeresis", "min": 0.1, "max": 5, "paso": 0.1 },
          { "tipo": "texto", "etiqueta": "Repositorio (usuario/repo)", "placeholder": "usuario/termostato", "se_recuerda": true },
          { "tipo": "contrasena", "etiqueta": "Token de GitHub", "se_recuerda": true },
          { "tipo": "boton", "texto": "Guardar cambios", "accion": "PUT control.json" }
        ],
        "mensajes": {
          "faltan_datos": "Indica el repositorio y el token.",
          "correcto": "Guardado. El termostato lo aplicara en menos de un minuto.",
          "error_github": "GitHub respondio {codigo}. Revisa el token y el repositorio.",
          "sin_conexion": "No se pudo conectar con GitHub."
        }
      }
    ],
    "errores_globales": { "carga_datos": "No se pueden cargar los datos todavia." }
  },

  "ejemplo_datos_mostrados": {
    "actual": { "fecha_hora": "2026-10-05T12:00:30", "temperatura": 21.4, "rele": false },
    "control": { "modo": "auto", "consigna": 21.0, "histeresis": 0.5 },
    "diario": {
      "2026-10-05": {
        "min": 19.8, "max": 22.1, "media": 21.0,
        "franjas": {
          "madrugada": { "min": 19.8, "max": 20.6, "media": 20.2 },
          "manana": { "min": 20.5, "max": 21.9, "media": 21.2 },
          "tarde": null,
          "noche": null
        }
      }
    }
  },

  "accesibilidad": {
    "zona_viva": "bloque de temperatura actual (aria-live polite)",
    "grafica": "role=img con descripcion de texto",
    "foco_visible": true,
    "responsive": "tablas con scroll horizontal; numero principal escala con el ancho de pantalla"
  }
}
